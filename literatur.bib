  pages = {2:1-2:17},
  publisher = {Schloss Dagstuhl – Leibniz-Zentrum für Informatik},
  issn = {2190-6807},
  doi = {10.4230/OASICS.WCET.2022.2},
  url = {https://drops.dagstuhl.de/entities/document/10.4230/OASIcs.WCET.2022.2},
  urldate = {2026-10-22},
  abstract = {We present llvmta, an academic WCET analysis tool based on the LLVM compiler infrastructure. It aims to enable the evaluation of novel WCET analysis approaches in a state-of-the-art analysis framework without dealing with the complexity of modeling real-world hardware architectures. We discuss the main design decisions and interfaces that allow to implement new analysis approaches. Finally, we highlight various existing research projects whose evaluation has been enabled by llvmta.},
  isbn = {9783959772440},
  langid = {english},
  keywords = {Computer systems organization → Real-time system architecture,LLVM,low-level analysis,Software and its engineering → Automated static analysis,Software and its engineering → Compilers,Software and its engineering → Software performance,WCET analysis}
}

